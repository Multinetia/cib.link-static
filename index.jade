  body
    // Preloader
    #preloader
      .preloader-container
        .sigle
        span Loading
    // Shell Panel
    #shell-panel
      .shell-info
      | Type <code>help</code> or hit <code>TAB</code> for a list of commands.
      | Press <code>Ctrl-C</code> to hide the console.
      #shell-view
    // Background slider
    #bg-slideshow(data-stellar-ratio="0.1")
      .overlay(data-stellar-ratio="1.1")
    // Header
    header#header.opNav
      h1
        | &#60;CIB&#62; Coders In Black
        span.glow
      nav.navbar.navbar-default.navbar-static-top(role="navigation")
        .container
          // Menu mobile
          .navbar-header
            a.logo(rel="home", href="#header", title="<CIB> Coders In Black") &#60;CIB&#62; Coders In Black
            button.navbar-toggle(type="button", data-toggle="collapse", data-target="#main-nav")
              span.sr-only Toggle navigation
              span.icon-bar
              span.icon-bar
              span.icon-bar
          // Menu desktop
          #main-nav.collapse.navbar-collapse
            a.logo(rel="home", href="#header", title="<CIB> Coders In Black") &#60;CIB&#62; Coders In Black
            ul.nav.navbar-nav
              li
                a(href="#who-we-are") Who we are
              li
                a(href="#how-it-works") How it works
              li
                a(href="#definitions") Definitions
              li
                a(href="#metrics") Metrics
              li
                a(href="#team") Coders in Black
              li
                a(href="#contact-us") Contact us
    // Intro
    section#home.opNav
      span.stamp.french-touch
      p.wow.fadeIn
        span
          | Build your
          strong disrupting
          | product in short iterations
      p.wow.fadeIn
        span
          | With
          strong passionate
          | people
      p.wow.fadeIn
        span
          | In
          strong amazing
          | places
      .overlay
    .site-wrapperTransp(data-stellar-vertical-offset="-10000", data-stellar-ratio="0.9")
      // Who we are
      // <section id="who-we-are" class="opNav" data-stellar-vertical-offset="-900" data-stellar-ratio="1.15">
      section#who-we-are.opNav
        .angle-top
          .angle-left
          .angle-right
        .wrapper
          .container
            h2.wow.pulse
              | Who
              strong we are&nbsp;
            article.row
              p.col-md-4.wow.slideInLeft
                span.picto.white.techno
                | We are&nbsp;
                strong products, apps, games, services, media solutions, infrastructure builders&nbsp;
                | using the most modern and efficient technologies.
              p.col-md-4.wow.fadeInUpBig
                span.picto.white.startup
                | We are&nbsp;
                strong developers, hackers, entrepreneurs, hard workers, architects&nbsp;
                | of multiple start-up systems.
              p.col-md-4.wow.slideInRight
                span.picto.white.lab
                | Early Adopters&nbsp;
                strong already working on the next disrupting product launch&nbsp;
                | for major companies in Media and Telecommunications.
    .site-wrapperBgColor
      // How it works
      // <section id="how-it-works" class="opNav" data-stellar-vertical-offset="1600" data-stellar-ratio="1.3">
      section#how-it-works.opNav(data-stellar-vertical-offset="-1600", data-stellar-ratio="1.1")
        .angle-top
          .angle-left
          .angle-right
        .wrapper
          .container
            h2.wow.flipInY
              | How it
              strong works
            article.row
              p.col-md-4.wow.fadeInUp
                span.num 1
                br
                | Tell us about your projects, we will select the one with&nbsp;
                strong the biggest disruption potential
                | .
              p.col-md-4.wow.fadeInUp
                span.num 2
                br
                | We organize a commando mission with you and our Task Force that&nbsp;
                strong will bring your project to life in few days
                | .
              p.col-md-4.wow.fadeInUp
                span.num 3
                br()
                | We deliver functionnal product at the end of each iteration.
                | You get the source, test it, work on it by yourself or 
                strong call us for the next commando iteration
      // Definitions
      section#definitions.opNav(data-stellar-vertical-offset="3500", data-stellar-ratio="1.3")
        .angle-top
          .angle-left
          .angle-right
        .wrapper
          .container
            
            h2.wow.fadeIn
              strong Definitions
            
            article#run.row
              h3.wow.bounceIn Run
              p
                strong A 3 to 4 days commando mission&nbsp;
                | (5 ot 6 days from arrival to departure) development iteration of your product with our expert team, who will live and work all day long with your own team, in an amazing, unique place.
              p Each run is a delivery iteration of functionnal product, to get feedback ASAP.
            article#packages.row
              h3.wow.bounceIn Packages
              .col-md-3
                .pack-radial-bar
                  div(data="1")
                  div(data="5")
                h4 Prototype
                p
                  | 1 to 5 x Runs, Proof of Concept, to find investors, associates, and show your product potential.
              .col-md-3
                .pack-radial-bar
                  div(data="4")
                  div(data="8")
                h4 Minimum Viable Product
                p 4 to 8 x Runs, to create a product that do the job and get feedbacks.
              .col-md-3
                .pack-radial-bar
                  div(data="7")
                  div(data="12")
                h4 Market Product
                p
                  | Go to market, get customers, get metrics on your business and join the competition.
              .col-md-3
                .pack-radial-bar
                  div(data="11")
                  div(data="30")
                h4 World Wide Information System
                p
                  | Modernize your complete technological business stack, to be ready for the challenges of tomorrow.
            

      // Definitions
      section#metrics.opNav
        .wrapper
          .container
            
            h2.wow.fadeIn
              strong Metrics


            article#where.row
              h3.wow.bounceIn 
                | <strong>#{metrics.missions}</strong> commando missions on <strong>#{metrics.projects}</strong> distinct projects in <strong>#{metrics.places}</strong> different places and <strong>5</strong> countries with <strong>#{metrics.team_mates}</strong> Coders In Black
              p
              .col-md-12
                iframe(src="where.html" width="100%" height="233" border=0)

